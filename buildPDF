#!/bin/sh

set -e

COMMON_ARGS="-halt-on-error"
OUTPUT_NAME="${OUTPUT_NAME:-documentation}"
OUTPUT_DIR="/data/out"
BUILD_DIR="${OUTPUT_DIR}/build"
LOG_FILE="${BUILD_DIR}/pandoc.log"

mkdir -p "${BUILD_DIR}"

if [ -n "${INPUT_FILES}" ]; then
    # shellcheck disable=SC2086
    set -- ${INPUT_FILES}
else
    set -- /data/chapters/*.md
fi

CODE_CAPTION_FILTER="/data/pandoc/filters/code-caption.lua"
PANDOC_EXTRA_ARGS="${PANDOC_EXTRA_ARGS:-}"

if [ -f /data/metadata.yaml ]; then
    set -- --metadata-file=/data/metadata.yaml "$@"
fi

if [ -f "${CODE_CAPTION_FILTER}" ]; then
    set -- --lua-filter="${CODE_CAPTION_FILTER}" "$@"
fi

if [ -n "${PANDOC_EXTRA_ARGS}" ]; then
    # shellcheck disable=SC2086
    set -- ${PANDOC_EXTRA_ARGS} "$@"
fi

(cd "${BUILD_DIR}" && pandoc --defaults=/usr/local/share/pandoc/defaults.yaml \
    --to=latex \
    --output "${BUILD_DIR}/${OUTPUT_NAME}.tex" \
    --standalone \
    --verbose \
    --biblatex \
    "$@" \
    > "${LOG_FILE}" 2>&1)

cd "${BUILD_DIR}"

xelatex ${COMMON_ARGS} "${OUTPUT_NAME}.tex"
if [ -f "${OUTPUT_NAME}.bcf" ] && command -v biber >/dev/null 2>&1; then
    biber "${OUTPUT_NAME}"
elif grep -q "\\bibdata" "${OUTPUT_NAME}.aux"; then
    bibtex "${OUTPUT_NAME}"
fi
xelatex ${COMMON_ARGS} "${OUTPUT_NAME}.tex"
xelatex ${COMMON_ARGS} "${OUTPUT_NAME}.tex"

mv -f "${BUILD_DIR}/${OUTPUT_NAME}.pdf" "${OUTPUT_DIR}/${OUTPUT_NAME}.pdf"
