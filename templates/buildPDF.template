#!/bin/sh

set -e

COMMON_ARGS="-halt-on-error"
OUTPUT_NAME="${OUTPUT_NAME:-documentation}"
OUTPUT_DIR="/data/out"
BUILD_DIR="${OUTPUT_DIR}/build"
LOG_FILE="${BUILD_DIR}/pandoc.log"
TEMPLATE="${TEMPLATE:-/usr/local/share/pandoc/templates/custom-template.tex}"
HEADER="${HEADER:-/usr/local/share/pandoc/templates/header.tex}"
HIGHLIGHT_THEME="${HIGHLIGHT_THEME:-/usr/local/share/pandoc/styles/code/vscode-light.theme}"
KROKI_FILTER="${KROKI_FILTER:-/usr/local/bin/pandoc-kroki-filter}"
DIAGRAM_SIZE_FILTER="${DIAGRAM_SIZE_FILTER:-/usr/local/share/pandoc/filters/diagram-size.lua}"
BIBLIOGRAPHY="${BIBLIOGRAPHY:-}"

if [ ! -f "${TEMPLATE}" ]; then
    TEMPLATE="/usr/local/share/pandoc/templates/custom-template.tex"
fi
if [ ! -f "${HEADER}" ]; then
    HEADER="/usr/local/share/pandoc/templates/header.tex"
fi
if [ ! -f "${HIGHLIGHT_THEME}" ]; then
    HIGHLIGHT_THEME="/usr/local/share/pandoc/styles/code/vscode-light.theme"
fi

mkdir -p "${BUILD_DIR}"

INPUT_GLOB="${INPUT_GLOB:-}"
INPUT_DIR="${INPUT_DIR:-}"

if [ -n "${INPUT_FILES}" ]; then
    # shellcheck disable=SC2086
    set -- ${INPUT_FILES}
elif [ -n "${INPUT_GLOB}" ]; then
    # shellcheck disable=SC2086
    set -- ${INPUT_GLOB}
elif [ -n "${INPUT_DIR}" ]; then
    if [ -d "${INPUT_DIR}" ] && ls "${INPUT_DIR}"/*.md >/dev/null 2>&1; then
        set -- "${INPUT_DIR}"/*.md
    else
        echo "ERROR: INPUT_DIR was provided but no .md files were found: ${INPUT_DIR}"
        exit 1
    fi
else
    echo "ERROR: INPUT_FILES is required."
    echo "Provide one of: INPUT_FILES (space-separated), INPUT_GLOB, or INPUT_DIR."
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo "ERROR: No input markdown files found."
    echo "Provide one of: INPUT_FILES (space-separated), INPUT_GLOB, or INPUT_DIR."
    exit 1
fi

META_ARG=""
if [ -f /data/metadata.yaml ]; then
    set -- --metadata-file=/data/metadata.yaml "$@"
fi

PANDOC_EXTRA_ARGS="${PANDOC_EXTRA_ARGS:-}"
case " ${PANDOC_EXTRA_ARGS} " in
    *" --listings "*) ;;
    *) PANDOC_EXTRA_ARGS="${PANDOC_EXTRA_ARGS} --listings" ;;
esac
CODE_CAPTION_FILTER="/usr/local/share/pandoc/filters/code-caption.lua"
if [ ! -f "${CODE_CAPTION_FILTER}" ]; then
    CODE_CAPTION_FILTER="/usr/local/share/pandoc/filters/code-caption.lua"
fi
CODE_CAPTION_ARG=""
if [ -f "${CODE_CAPTION_FILTER}" ]; then
    CODE_CAPTION_ARG="--lua-filter=${CODE_CAPTION_FILTER}"
fi

DATE_METADATA_FILTER=""
if [ -f "/usr/local/share/pandoc/filters/date-metadata.lua" ]; then
    DATE_METADATA_FILTER="/usr/local/share/pandoc/filters/date-metadata.lua"
fi
DATE_METADATA_ARG=""
if [ -n "${DATE_METADATA_FILTER}" ]; then
    DATE_METADATA_ARG="--lua-filter=${DATE_METADATA_FILTER}"
fi

SVG_TO_RASTER_FILTER="${SVG_TO_RASTER_FILTER:-/usr/local/share/pandoc/filters/svg-to-raster.lua}"
SVG_TO_RASTER_ARG=""
if [ -f "${SVG_TO_RASTER_FILTER}" ]; then
    SVG_TO_RASTER_ARG="--lua-filter=${SVG_TO_RASTER_FILTER}"
fi

TEMPLATE_ARG=""
if [ -f "${TEMPLATE}" ]; then
    TEMPLATE_ARG="--template=${TEMPLATE}"
fi

HEADER_ARG=""
if [ -f "${HEADER}" ]; then
    HEADER_ARG="-H ${HEADER}"
fi

HIGHLIGHT_ARG=""
if [ -f "${HIGHLIGHT_THEME}" ]; then
    HIGHLIGHT_ARG="--highlight-style=${HIGHLIGHT_THEME}"
fi

KROKI_ARG=""
if [ -f "${KROKI_FILTER}" ]; then
    KROKI_ARG="--filter ${KROKI_FILTER}"
fi

DIAGRAM_SIZE_ARG=""
if [ -f "${DIAGRAM_SIZE_FILTER}" ]; then
    DIAGRAM_SIZE_ARG="--lua-filter=${DIAGRAM_SIZE_FILTER}"
fi

BIBLIOGRAPHY_ARG=""
if [ -n "${BIBLIOGRAPHY}" ]; then
    BIBLIOGRAPHY_ARG="--bibliography=${BIBLIOGRAPHY}"
fi

echo "=== Starting Pandoc processing ==="
echo "Template: ${TEMPLATE}"
echo "Header: ${HEADER}"
echo "Code caption filter: ${CODE_CAPTION_FILTER}"
echo "Diagram size filter: ${DIAGRAM_SIZE_FILTER}"
echo "SVG raster filter: ${SVG_TO_RASTER_FILTER}"
echo "Input files: $@"
echo "Working directory: $(pwd)"

########
# Pandoc Invocation
# ---
# Run Pandoc first so LaTeX and bibliography files are generated.
(cd "${BUILD_DIR}" && pandoc --defaults=/usr/local/share/pandoc/defaults.yaml \
    ${META_ARG} \
    ${TEMPLATE_ARG} \
    ${HEADER_ARG} \
    ${HIGHLIGHT_ARG} \
    ${KROKI_ARG} \
    ${DIAGRAM_SIZE_ARG} \
    ${BIBLIOGRAPHY_ARG} \
    --to=latex \
    --output "${BUILD_DIR}/${OUTPUT_NAME}.tex" \
    --standalone \
    --verbose \
    ${SVG_TO_RASTER_ARG} \
    ${CODE_CAPTION_ARG} \
    ${DATE_METADATA_ARG} \
    ${PANDOC_EXTRA_ARGS} \
    "$@" \
    2>&1 | tee "${LOG_FILE}")

if [ ! -f "${BUILD_DIR}/${OUTPUT_NAME}.tex" ]; then
    echo "ERROR: Pandoc failed to generate ${OUTPUT_NAME}.tex"
    echo "Check the log file: ${LOG_FILE}"
    exit 1
fi

echo "=== Pandoc processing complete ==="
echo "Generated: ${BUILD_DIR}/${OUTPUT_NAME}.tex"
echo "=== Starting LaTeX compilation ==="

cd "${BUILD_DIR}"

echo "Running xelatex (first pass)..."
xelatex ${COMMON_ARGS} "${OUTPUT_NAME}.tex"

if grep -q "\\bibdata" "${OUTPUT_NAME}.aux"; then
    echo "Running bibtex..."
    bibtex "${OUTPUT_NAME}"
fi

echo "Running xelatex (second pass)..."
xelatex ${COMMON_ARGS} "${OUTPUT_NAME}.tex"

echo "Running xelatex (third pass)..."
xelatex ${COMMON_ARGS} "${OUTPUT_NAME}.tex"

mv -f "${BUILD_DIR}/${OUTPUT_NAME}.pdf" "${OUTPUT_DIR}/${OUTPUT_NAME}.pdf"

echo "=== Build complete ==="
echo "PDF created at: ${OUTPUT_DIR}/${OUTPUT_NAME}.pdf"
echo "Log file: ${LOG_FILE}"
