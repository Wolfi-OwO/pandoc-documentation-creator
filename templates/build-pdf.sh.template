#!/bin/bash

# Pandoc Documentation Creator - Build Script
# This script builds your documentation into a PDF

set -e

# Configuration
IMAGE_NAME="registry.gitlab.com/woofi4/public/pandoc-documentation-creator:latest"
# For local development, uncomment the line below:
# IMAGE_NAME="pandoc-documentation-creator:latest"
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUTPUT_DIR="${PROJECT_DIR}/output"
CHAPTERS_DIR="${PROJECT_DIR}/chapters"
PANDOC_DIR="${PROJECT_DIR}/.pandoc"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=======================================${NC}"
echo -e "${BLUE}Pandoc Documentation Creator${NC}"
echo -e "${BLUE}Building PDF...${NC}"
echo -e "${BLUE}=======================================${NC}"
echo ""

# Check if Docker image exists
if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
    echo -e "${RED}Error: Docker image '${IMAGE_NAME}' not found${NC}"
    echo -e "${YELLOW}Pulling image from GitLab registry...${NC}"
    docker pull "${IMAGE_NAME}" || {
        echo -e "${RED}Failed to pull image${NC}"
        exit 1
    }
fi

# Check if chapters directory exists
if [ ! -d "${CHAPTERS_DIR}" ]; then
    echo -e "${RED}Error: chapters/ directory not found${NC}"
    echo -e "${YELLOW}Please run './init.sh new' to create project structure${NC}"
    exit 1
fi

# Check if any markdown files exist
if ! ls "${CHAPTERS_DIR}"/*.md >/dev/null 2>&1; then
    echo -e "${RED}Error: No markdown files found in chapters/${NC}"
    echo -e "${YELLOW}Add your documentation files to the chapters/ directory${NC}"
    exit 1
fi

# Create output directory if it doesn't exist
mkdir -p "${OUTPUT_DIR}"

# Count markdown files
FILE_COUNT=$(ls -1 "${CHAPTERS_DIR}"/*.md 2>/dev/null | wc -l)
echo -e "${BLUE}Found ${FILE_COUNT} markdown file(s)${NC}"
echo ""

# Build PDF
echo -e "${YELLOW}Generating PDF...${NC}"

docker run --rm \
  -v "${PROJECT_DIR}:/data" \
  "${IMAGE_NAME}" \
  --defaults=/usr/local/share/pandoc/defaults.yaml \
  --metadata-file=/data/metadata.yaml \
  /data/chapters/'*.md' \
  -o /data/output/documentation.pdf

if [ $? -eq 0 ]; then
    echo ""
    echo -e "${GREEN}=======================================${NC}"
    echo -e "${GREEN}Build successful!${NC}"
    echo -e "${GREEN}=======================================${NC}"
    echo -e "${GREEN}Output: ${OUTPUT_DIR}/documentation.pdf${NC}"
    
    # Get file size
    if [ -f "${OUTPUT_DIR}/documentation.pdf" ]; then
        SIZE=$(du -h "${OUTPUT_DIR}/documentation.pdf" | cut -f1)
        echo -e "${BLUE}File size: ${SIZE}${NC}"
    fi
else
    echo ""
    echo -e "${RED}=======================================${NC}"
    echo -e "${RED}Build failed!${NC}"
    echo -e "${RED}=======================================${NC}"
    echo -e "${YELLOW}Check the error messages above${NC}"
    exit 1
fi
