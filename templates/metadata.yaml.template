# Metadata file for Pandoc documentation
# Edit these values to customize your document

# Document information
title: "Project Documentation"
subtitle: ""
author: "Your Name"
date: "" # Leave empty for automatic date

# Language and localization
lang: en-US

# Document class (scrartcl, scrreprt, scrbook)
documentclass: scrartcl

# Font settings
mainfont: "Liberation Serif"
sansfont: "Liberation Sans"
monofont: "Liberation Mono"

# Paper and layout
papersize: a4
fontsize: 11pt
linestretch: 1.15

# Colors
linkcolor: blue
urlcolor: blue
citecolor: brown
toccolor: black

# Abstract (optional)
abstract: ""

# Table of contents settings
toc-title: "Table of Contents"
lof: false # List of figures
# lof-title: "List of Figures"
lot: false # List of tables
# lot-title: "List of Tables"
toc-depth: 3

# Section numbering
numbersections: true
secnumdepth: 3

# Custom logo (optional, path relative to project root)
# logo: "media/logo.png"

# Header and footer customization
header-left: "Default Left Header"
header-center: "Default Center Header"
header-right: \today
footer-left: "Default Left Footer"
footer-center: "Default Center Footer"
footer-right: \pagemark