{
  "yaml.schemas": {
    ".vscode/schemas/pandoc-metadata.json": [
      "metadata.yaml",
      "templates/metadata.yaml.template",
      "**/metadata.yaml"
    ]
  },
  "yaml.format.enable": true,
  "yaml.validate": true,
  "yaml.customTags": [
    "!include scalar",
    "!reference sequence"
  ],
  "files.associations": {
    "metadata.yaml": "yaml",
    "*.yaml.template": "yaml"
  }
}
